{
  "name": "spotify-recreation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests *.ts *.json *.md",
    "format:check": "prettier --check src tests *.ts *.json *.md",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "preview:pages": "vite preview --mode github-pages --host 127.0.0.1",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
